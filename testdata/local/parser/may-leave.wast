;; resource.rep is allowed in realloc
(component
  (component $p
    (core module $m (func (export "f")))
    (core instance $i (instantiate $m))
    (func (export "imported") (canon lift (core func $i "f"))))
  (instance $pi (instantiate $p))
  (alias export $pi "imported" (func $imp))
  (core func $lowered (canon lower (func $imp)))
  (type $r (resource (rep i32)))
  (core func $rnew (canon resource.new $r))
  (core func $rrep (canon resource.rep $r))
  (core instance $env
    (export "imported" (func $lowered))
    (export "new" (func $rnew)) (export "rep" (func $rrep)))
  (core module $m (import "env" "imported" (func $imported))
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (memory (export "m") 1)
    (data (i32.const 0) "\08\00\00\00\05\00\00\00hello")
    (global $h (mut i32) (i32.const 0))
    (func (export "setup") (global.set $h (call $new (i32.const 7))))
    (func (export "r") (param i32 i32 i32 i32) (result i32) (drop (call $rep (global.get $h))) i32.const 1024)
    (func (export "go") (param i32 i32)))
  (core instance $i (instantiate $m (with "env" (instance $env))))
  (func (export "setup") (canon lift (core func $i "setup")))
  (func (export "go") (param "s" string)
    (canon lift (core func $i "go") (memory $i "m") (realloc (func $i "r")))))
(assert_return (invoke "setup"))
(assert_return (invoke "go" (str.const "hello")))

