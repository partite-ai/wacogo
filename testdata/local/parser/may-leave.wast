;; A component can't call a lowered import while it is being lowered into or
;; cleaned up: canon_lower traps unless may_leave is true, which is false during
;; realloc and post-return. resource.rep is exempt from that check.
;;
;; wasmtime matches all of this except that it allows the last trapping case below,
;; a post-return reached from another wasm component. The spec doesn't.

;; calling an import is fine outside those windows
(component
  (component $p
    (core module $m (func (export "f")))
    (core instance $i (instantiate $m))
    (func (export "imported") (canon lift (core func $i "f"))))
  (instance $pi (instantiate $p))
  (alias export $pi "imported" (func $imp))
  (core func $lowered (canon lower (func $imp)))
  (type $r (resource (rep i32)))
  (core func $rnew (canon resource.new $r))
  (core func $rrep (canon resource.rep $r))
  (core instance $env
    (export "imported" (func $lowered))
    (export "new" (func $rnew)) (export "rep" (func $rrep)))
  (core module $m (import "env" "imported" (func $imported))
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (memory (export "m") 1)
    (data (i32.const 0) "\08\00\00\00\05\00\00\00hello")
    (global $h (mut i32) (i32.const 0))
    (func (export "go") (call $imported)))
  (core instance $i (instantiate $m (with "env" (instance $env))))
  (func (export "go") (canon lift (core func $i "go"))))
(assert_return (invoke "go"))

;; nothing leaves, nothing traps
(component
  (component $p
    (core module $m (func (export "f")))
    (core instance $i (instantiate $m))
    (func (export "imported") (canon lift (core func $i "f"))))
  (instance $pi (instantiate $p))
  (alias export $pi "imported" (func $imp))
  (core func $lowered (canon lower (func $imp)))
  (type $r (resource (rep i32)))
  (core func $rnew (canon resource.new $r))
  (core func $rrep (canon resource.rep $r))
  (core instance $env
    (export "imported" (func $lowered))
    (export "new" (func $rnew)) (export "rep" (func $rrep)))
  (component $callee
    (import "imported" (func $imp))
    (type $r (resource (rep i32)))
    (core func $lowered (canon lower (func $imp)))
    (core func $rnew (canon resource.new $r))
    (core func $rrep (canon resource.rep $r))
    (core instance $env
      (export "imported" (func $lowered))
      (export "new" (func $rnew)) (export "rep" (func $rrep)))
    (core module $m (import "env" "imported" (func $imported))
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (memory (export "m") 1)
    (data (i32.const 0) "\08\00\00\00\05\00\00\00hello")
    (global $h (mut i32) (i32.const 0))
      (func (export "r") (param i32 i32 i32 i32) (result i32)  i32.const 1024)
      (func (export "post") (param i32) )
      (func (export "echo") (param i32 i32) (result i32) i32.const 0))
    (core instance $i (instantiate $m (with "env" (instance $env))))
    (func (export "echo") (param "s" string) (result string)
      (canon lift (core func $i "echo") (memory $i "m") (realloc (func $i "r")) (post-return (func $i "post")))))
  (instance $ci (instantiate $callee (with "imported" (func $imp))))
  (alias export $ci "echo" (func $echo))
  (core module $mm (import "env" "imported" (func $imported))
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (memory (export "m") 1)
    (data (i32.const 0) "\08\00\00\00\05\00\00\00hello")
    (global $h (mut i32) (i32.const 0))
    (func (export "r") (param i32 i32 i32 i32) (result i32)  i32.const 2048))
  (core instance $mi (instantiate $mm (with "env" (instance $env))))
  (core func $lecho (canon lower (func $echo) (memory $mi "m") (realloc (func $mi "r"))))
  (core instance $env2 (export "echo" (func $lecho)))
  (core module $u
    (import "e" "echo" (func $echo (param i32 i32 i32)))
    (func (export "go") (call $echo (i32.const 8) (i32.const 5) (i32.const 64))))
  (core instance $ui (instantiate $u (with "e" (instance $env2))))
  (func (export "go") (canon lift (core func $ui "go"))))
(assert_return (invoke "go"))

;; realloc, called from outside
(component
  (component $p
    (core module $m (func (export "f")))
    (core instance $i (instantiate $m))
    (func (export "imported") (canon lift (core func $i "f"))))
  (instance $pi (instantiate $p))
  (alias export $pi "imported" (func $imp))
  (core func $lowered (canon lower (func $imp)))
  (type $r (resource (rep i32)))
  (core func $rnew (canon resource.new $r))
  (core func $rrep (canon resource.rep $r))
  (core instance $env
    (export "imported" (func $lowered))
    (export "new" (func $rnew)) (export "rep" (func $rrep)))
  (core module $m (import "env" "imported" (func $imported))
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (memory (export "m") 1)
    (data (i32.const 0) "\08\00\00\00\05\00\00\00hello")
    (global $h (mut i32) (i32.const 0))
    (func (export "setup") (global.set $h (call $new (i32.const 7))))
    (func (export "r") (param i32 i32 i32 i32) (result i32) (call $imported) i32.const 1024)
    (func (export "go") (param i32 i32)))
  (core instance $i (instantiate $m (with "env" (instance $env))))
  (func (export "setup") (canon lift (core func $i "setup")))
  (func (export "go") (param "s" string)
    (canon lift (core func $i "go") (memory $i "m") (realloc (func $i "r")))))
(assert_trap (invoke "go" (str.const "hello")) "cannot leave component instance")

;; post-return, called from outside
(component
  (component $p
    (core module $m (func (export "f")))
    (core instance $i (instantiate $m))
    (func (export "imported") (canon lift (core func $i "f"))))
