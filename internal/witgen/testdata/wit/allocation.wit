package example:demo;

interface allocation {
    record wide {
        a: u64,
        b: u64,
        c: u64,
        d: u64,
        e: u64,
        f: u64,
        g: u64,
        h: u64,
    }

    nested: func(xs: list<list<u8>>);
    nested-strings: func(xs: list<list<string>>);
    pair: func(left: list<string>, right: list<string>);
    absent: func(xs: list<option<wide>>);
}

world allocation-host {
    import allocation;
}
