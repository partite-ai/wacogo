// handleState is the package-private state machine driving each
// *<R>Handle. Four implementations (unregistered, bound, invalidated,
// shortcut-borrow) cover the lifecycle. bind returns the next state
// plus the canon handle to use for this call; drop releases the canon
// entry if one was issued.
type handleState interface {
	bind(cc *host.CallContext, owner *host.ComponentInstance) (handleState, uint32, error)
	drop(ctx context.Context) error
}

// handle is the package-private sealed interface implemented by every
// *<R>Handle in this package. Package-private to side-step potential
// name collisions with resources literally named "handle"; structural
// conformance still works for cross-package callers because only types
// defined here satisfy the unexported methods.
type handle interface {
	bind(cc *host.CallContext, owner *host.ComponentInstance) (uint32, error)
	Invalidate()
}

// boundHandleState — handle wraps a live wacogo.ResourceHandle. All
// instance / handle-id / drop semantics flow through rh.
type boundHandleState struct {
	rh wacogo.ResourceHandle
}

func (s *boundHandleState) bind(cc *host.CallContext, _ *host.ComponentInstance) (handleState, uint32, error) {
	if s.rh == nil {
		return nil, 0, fmt.Errorf("wacogo/witgen: handle already dropped")
	}
	if s.rh.Instance() != cc.Instance() {
		return nil, 0, fmt.Errorf("wacogo/witgen: handle bound to wrong instance")
	}
	return s, s.rh.HandleID(), nil
}

func (s *boundHandleState) drop(ctx context.Context) error {
	if s.rh == nil {
		return nil
	}
	err_ := s.rh.Drop(ctx)
	s.rh = nil
	return err_
}

// unregisteredHandleState — impl held in Go memory; not yet in any
// extTable or canon table. On first bind, the impl is registered on
// definer (or owner, if definer was nil) and an own handle is issued
// onto cc.Instance(); the state transitions to bound.
//
// trGetter resolves the per-instance *wacogo.TypeResource for the
// resource this handle is for by reading a field on the definer's
// *instanceState. Each New<R>Handle / New<R>HandleIn pins a getter that
// targets the matching resource field; bind asserts the definer's
// UserState to *instanceState and calls it.
type unregisteredHandleState struct {
	definer  *host.ComponentInstance // nil = same-package; resolved to owner at bind time
	trGetter func(*instanceState) *wacogo.TypeResource
	impl     any
}

func (s *unregisteredHandleState) bind(cc *host.CallContext, owner *host.ComponentInstance) (handleState, uint32, error) {
	definer_ := s.definer
	if definer_ == nil {
		definer_ = owner
	}
	state_, ok_ := definer_.UserState().(*instanceState)
	if !ok_ {
		return nil, 0, fmt.Errorf("wacogo/witgen: resources not defined in this component must be created via NewXXXHandleIn")
	}
	tr_ := s.trGetter(state_)
	eh_ := definer_.RegisterResource(s.impl)
	rh_ := cc.IssueOwnHandle(tr_, uint32(eh_))
	return &boundHandleState{rh: rh_}, rh_.HandleID(), nil
}

func (s *unregisteredHandleState) drop(ctx context.Context) error {
	if d_, ok_ := s.impl.(interface{ Drop(context.Context) error }); ok_ {
		return d_.Drop(ctx)
	}
	return nil
}

// invalidatedHandleState — handle was transferred out or invalidated.
// Any further bind fails; drop is a no-op.
type invalidatedHandleState struct{}

func (invalidatedHandleState) bind(_ *host.CallContext, _ *host.ComponentInstance) (handleState, uint32, error) {
	return nil, 0, fmt.Errorf("wacogo/witgen: handle has been invalidated")
}

func (invalidatedHandleState) drop(ctx context.Context) error { return nil }

// shortcutBorrowHandleState — handle received via the canonical-ABI
// same-component shortcut: the wire value was the rep itself, with no
// callee-side table entry. defining is the resource's defining
// component instance; rep indexes its extern table; impl is the value
// resolved at lift time so LocalImpl returns it directly. Re-binding is
// only valid when the next call targets defining (the shortcut applies
// again); other targets error. drop is a no-op — the lent borrow is
// scoped on the lender's side, not the callee's.
type shortcutBorrowHandleState struct {
	defining *host.ComponentInstance
	rep      uint32
	impl     any
}

func (s *shortcutBorrowHandleState) bind(cc *host.CallContext, _ *host.ComponentInstance) (handleState, uint32, error) {
	if cc.Instance() != s.defining.Core() {
		return nil, 0, fmt.Errorf("wacogo/witgen: shortcut-borrow handle cannot be re-passed to a non-defining instance")
	}
	return s, s.rep, nil
}

func (s *shortcutBorrowHandleState) drop(_ context.Context) error { return nil }

// HandleValueFor is intended for generated bindings in packages that
// import this interface. End users do not call it directly. It returns
// the canon handle value that should be placed on the wire for h.
func HandleValueFor(cc *host.CallContext, owner *host.ComponentInstance, h handle) (uint32, error) {
	return h.bind(cc, owner)
}
